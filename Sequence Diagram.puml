@startuml
title School Facility Rental - Activity

|Renter|
start

repeat
:Choose facility and date;

|Website|
:Check availability;

if (available?) then (yes)
    :Create request;
    :Request Contact Information;
    |Renter|
    :Enters Contact Information;
    :Submits Form;
    |Staff|
    if (Approve application?) then (yes)
        |Renter|
        :Payment Service charges renter;
        if (payment declines?) then (yes)
            |Website|
            :Records payment declined;
            |Renter|
            :Receives a payment declined email;
            stop
        else (no)
            |Website|
            :Saves booking;
            :Sends confirmation email;
            stop
        endif
    else (no)
        |Website|
        :Record Rejection;
        |Renter|
        :Receives email about rejection;
        stop
    endif
else (no)
    |Website|
    :Show not available;

    |Renter|
    if (Choose another date or spot) then (no)
        stop
    else (yes)
    endif

endif

repeat while (Choose again?)
@enduml






@startuml
title School Facility Rental - Sequence


actor Renter
participant Website
participant "School Staff" as Staff
participant "Payment Service" as Pay
participant "Email Service" as Email

Renter -> Website: submit request
loop Until facility is available

    alt no availability
        Website --> Renter: No availability
        Renter -> Website: Chooses different facility/date
    else availability
            Website --> Renter: Requests Contact Information
            Renter -> Website: Submits form
end
end


Website -> Staff: send request for review


alt approved
Staff --> Website: approved
Website -> Pay: Request Payment Service
    alt Payment Approved
    Pay --> Website: Payment approved
    Website -> Website: Saves booking
    Website -> Email: Request Email be sent to renter
    Email -> Renter: Receives Email about confirmation
    else rejected
    Pay --> Website: Rejected
    Website -> Email: Requests email be sent to renter
    Email -> Renter: Receives email about rejection
    end
else rejected
Staff --> Website: rejected
Website -> Website: Records rejection
Website -> Email: Requests email be sent to renter
Email -> Renter: Receives email about rejection
end
@enduml